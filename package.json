{
  "name": "cursor-alternative",
  "version": "0.1.0",
  "description": "Open-source AI-first code editor with MCP support and extensible skills system",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn dev:electron\" \"yarn dev:frontend\"",
    "dev:electron": "electron-dev .",
    "dev:frontend": "vite --host",
    "build": "vite build && electron-builder",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "mcp:dev": "node --loader ts-node/esm src/mcp/server.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "monaco-editor": "^0.50.0",
    "@anthropic-ai/sdk": "^0.13.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0",
    "pino": "^8.16.0",
    "electron-squirrel-startup": "^1.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "electron-dev": "^1.0.0",
    "concurrently": "^8.2.0",
    "ts-node": "^10.9.0",
    "eslint": "^8.54.0",
    "vitest": "^0.34.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
